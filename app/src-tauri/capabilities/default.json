{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the editor windows",
  "windows": [
    "main",
    "editor-*",
    "compare-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-message",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
